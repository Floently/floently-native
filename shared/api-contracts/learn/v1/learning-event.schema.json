{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://floently.com/contracts/learn/v1/learner-event.schema.json",
  "title": "LearnerEvent",
  "description": "Mirror of packages/core/schemas/learning.ts LearnerEvent.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "eventId",
    "learnerId",
    "occurredAt",
    "eventKind",
    "taskId",
    "contentVersion",
    "pathway",
    "runtime",
    "skills",
    "levelBand"
  ],
  "properties": {
    "schemaVersion": { "const": "learning.v1" },
    "eventId": { "type": "string", "minLength": 1 },
    "learnerId": { "type": "string", "minLength": 1 },
    "occurredAt": { "type": "string", "format": "date-time" },
    "eventKind": {
      "type": "string",
      "enum": [
        "task_started",
        "task_completed",
        "task_skipped",
        "task_abandoned",
        "answer_submitted",
        "answer_corrected",
        "retry_completed",
        "writing_submitted",
        "writing_retried",
        "speaking_submitted",
        "reading_completed",
        "listening_completed"
      ]
    },
    "taskId": { "type": "string", "minLength": 1 },
    "contentVersion": { "type": "string", "minLength": 1 },
    "attemptId": { "type": "string", "minLength": 1 },
    "pathway": {
      "type": "string",
      "enum": ["everyday", "professional", "yki"]
    },
    "runtime": {
      "type": "string",
      "enum": [
        "cards",
        "roleplay",
        "reading",
        "writing",
        "listening",
        "yki",
        "professional_mission",
        "grammar"
      ]
    },
    "skills": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": [
          "vocabulary",
          "grammar",
          "listening",
          "speaking",
          "reading",
          "writing"
        ]
      }
    },
    "levelBand": { "type": "string", "minLength": 1 },
    "profession": { "type": "string", "minLength": 1 },
    "contextId": { "type": "string", "minLength": 1 },
    "score": { "type": "number" },
    "maxScore": { "type": "number", "minimum": 0 },
    "metadata": {
      "type": "object",
      "additionalProperties": {
        "type": ["string", "number", "boolean"]
      }
    }
  }
}
