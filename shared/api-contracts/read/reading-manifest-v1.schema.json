{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://floently.com/contracts/read/reading-manifest-v1.schema.json",
  "title": "Floently ReadingManifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "documentId",
    "revisionId",
    "title",
    "language",
    "wordCount",
    "textScalarLength",
    "estimatedSourceDurationMs",
    "segments"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "documentId": { "type": "string", "minLength": 1 },
    "revisionId": { "type": "string", "minLength": 1 },
    "title": { "type": "string" },
    "language": { "type": "string" },
    "wordCount": { "type": "integer", "minimum": 0 },
    "textScalarLength": { "type": "integer", "minimum": 0 },
    "estimatedSourceDurationMs": { "type": "integer", "minimum": 0 },
    "segments": {
      "type": "array",
      "items": { "$ref": "#/$defs/segment" }
    }
  },
  "$defs": {
    "segment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "index",
        "text",
        "scalarStart",
        "scalarEnd",
        "wordStart",
        "wordEnd",
        "wordCount",
        "estimatedSourceDurationMs",
        "logicalStartMs",
        "logicalEndMs"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "index": { "type": "integer", "minimum": 0 },
        "text": { "type": "string" },
        "scalarStart": { "type": "integer", "minimum": 0 },
        "scalarEnd": { "type": "integer", "minimum": 0 },
        "wordStart": { "type": "integer", "minimum": 0 },
        "wordEnd": { "type": "integer", "minimum": 0 },
        "wordCount": { "type": "integer", "minimum": 0 },
        "estimatedSourceDurationMs": { "type": "integer", "minimum": 0 },
        "logicalStartMs": { "type": "integer", "minimum": 0 },
        "logicalEndMs": { "type": "integer", "minimum": 0 },
        "synthesis": { "$ref": "#/$defs/synthesis" },
        "audio": { "$ref": "#/$defs/audio" },
        "timings": {
          "type": "array",
          "items": { "$ref": "#/$defs/timing" }
        }
      }
    },
    "synthesis": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["pending", "generating", "ready", "failed"]
        },
        "requestKey": { "type": "string" },
        "voiceId": { "type": "string" },
        "provider": { "type": "string" },
        "model": { "type": "string" },
        "errorCode": { "type": "string" },
        "errorMessage": { "type": "string" }
      }
    },
    "audio": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["uri", "durationMs"],
      "properties": {
        "uri": { "type": "string", "minLength": 1 },
        "durationMs": { "type": "integer", "minimum": 0 },
        "contentHash": { "type": "string" },
        "cacheKey": { "type": "string" },
        "voiceId": { "type": "string" },
        "provider": { "type": "string" },
        "model": { "type": "string" },
        "format": { "type": "string" }
      }
    },
    "timing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scalarStart", "scalarEnd", "startMs", "endMs"],
      "properties": {
        "scalarStart": { "type": "integer", "minimum": 0 },
        "scalarEnd": { "type": "integer", "minimum": 0 },
        "startMs": { "type": "integer", "minimum": 0 },
        "endMs": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
