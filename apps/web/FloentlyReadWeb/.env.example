# Floently Read next-generation web runtime
#
# Production host routing has built-in defaults. These values are primarily
# useful for local, preview, and staging deployments.

# Shared Floently/Learn authentication API base.
# Example: https://learn-api.floently.com
VITE_AUTH_API_URL=

# Optional general API fallback used when VITE_AUTH_API_URL is empty.
VITE_API_URL=

# READ TTS/voice API. Leave empty to use the provider's current default.
# Example: https://flowreader-api.onrender.com
VITE_READ_API_BASE_URL=
